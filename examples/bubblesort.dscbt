// bubblesort.dscbt - 冒泡排序

arr = [64, 34, 25, 12, 22, 11, 90]
n = len(arr)

print("排序前:")
k = 0
while k < n:
    print(arr[k])
    k = k + 1

for i in range(n):
    j = 0
    while j < n - i - 1:
        if arr[j] > arr[j + 1]:
            tmp = arr[j]
            arr[j] = arr[j + 1]
            arr[j + 1] = tmp
        j = j + 1

print("排序后:")
k = 0
while k < n:
    print(arr[k])
    k = k + 1
