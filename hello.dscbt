# Variables
x = 10
y = 20
print(x + y)

# While loop
i = 0
while i < 3:
    print(i)
    i = i + 1

# For loop
for j in range(5):
    print(j)

# If/Else
if x < y:
    print("x is less than y")
els:
    print("x is not less than y")

# Function
