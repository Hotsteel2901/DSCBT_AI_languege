# Test: functions, control flow, arrays, logic

# 1. Simple if/else
x = 10
if x > 5:
    print(x)
els:
    print(0)

# 2. While loop
i = 0
s = 0
while i < 5:
    s = s + i
    i = i + 1
print(s)

# 3. For loop
total = 0
for i in range(4):
    total = total + i
print(total)

# 4. Function call
def add(a, b):
    return a + b

result = add(100, 200)
print(result)

# 5. Array
arr = [1, 2, 3, 4, 5]
print(arr[0])
print(arr[4])
print(len(arr))

# 6. Short-circuit logic
a = True
b = False
c = a and b
print(c)
d = a or b
print(d)

# 7. Nested function call
def square(x):
    return x * x

def sum_sq(a, b):
    return square(a) + square(b)

print(sum_sq(3, 4))

# 8. String concatenation
name = "hello"
greet = name + " world"
print(greet)
